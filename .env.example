# Copy to .env.local and fill in. Never commit .env.local.

# ---- Supabase ----
# Project Settings -> Data API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Project Settings -> API Keys -> anon / public  (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Project Settings -> API Keys -> service_role  (SERVER ONLY — bypasses RLS, never expose)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Email (SMTP, e.g. Gmail app password) ----
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your@gmail.com
SENDER_PASSWORD=your-app-password
RECEIVER_EMAIL=altveentechnologies@gmail.com

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
